# Kopiera till .env. Hemligheter läggs aldrig i repo (SPEC 10).
DATABASE_URL=postgresql+psycopg://vskalkyl:vskalkyl@localhost:5432/vskalkyl
TEST_DATABASE_URL=postgresql+psycopg://vskalkyl:vskalkyl@localhost:5432/vskalkyl_test
REDIS_URL=redis://localhost:6379/0

S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=vs-kalkyl

# AI-leverantör. Vilka leverantörer som är godkända är ÖPPEN FRÅGA 11 (SPEC 14).
AI_PROVIDER=anthropic
# Anthropic: DAHLNY_ANTHROPIC_API_KEY läses i första hand. I Claude Codes molnmiljö är ANTHROPIC_API_KEY och
# ANTHROPIC_BASE_URL reserverade av Claude Code själv – lägg nyckeln som DAHLNY_ANTHROPIC_API_KEY i miljöns
# inställningar. ANTHROPIC_API_KEY fungerar som reserv på en egen dator.
DAHLNY_ANTHROPIC_API_KEY=
# Adressen läses aldrig från ANTHROPIC_BASE_URL. Ändra bara om ni går via en egen proxy eller molnregion.
DAHLNY_ANTHROPIC_BASE_URL=https://api.anthropic.com
OPENAI_API_KEY=
GOOGLE_API_KEY=

# Ritningsmotorn (SPEC 6.4.7) körs i egen miljö, t.ex. en separat venv med Dahlvvvs/engine installerat.
VVS_ENGINE_CMD=vvs-takeoff
