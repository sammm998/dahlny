# Kopiera till .env. Hemligheter läggs aldrig i repo (SPEC 10).
DATABASE_URL=postgresql+psycopg://vskalkyl:vskalkyl@localhost:5432/vskalkyl
TEST_DATABASE_URL=postgresql+psycopg://vskalkyl:vskalkyl@localhost:5432/vskalkyl_test
REDIS_URL=redis://localhost:6379/0

S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=vs-kalkyl

# AI-leverantör. Vilka leverantörer som är godkända är ÖPPEN FRÅGA 11 (SPEC 14).
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# Ritningsmotorn (SPEC 6.4.7) körs i egen miljö, t.ex. en separat venv med Dahlvvvs/engine installerat.
VVS_ENGINE_CMD=vvs-takeoff
